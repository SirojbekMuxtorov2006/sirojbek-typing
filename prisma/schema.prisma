datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String            @id @default(cuid())
  name              String?
  email             String?           @unique
  emailVerified     DateTime?
  password          String?
  image             String?
  role              String            @default("USER") // USER, MODERATOR, ADMIN
  bio               String?
  typingGoalWpm     Int               @default(70)
  preferredLanguage String            @default("en")   // en, uz, ru
  preferredTheme    String            @default("dark")
  xp                Int               @default(0)
  level             Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  accounts          Account[]
  sessions          Session[]
  typingResults     TypingResult[]
  lessonProgress    LessonProgress[]
  userAchievements  UserAchievement[]
  userChallenges    UserChallenge[]
  userStatistics    UserStatistics?
  gameSessions      GameSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TypingResult {
  id             String   @id @default(cuid())
  userId         String?
  isGuest        Boolean  @default(false)
  guestName      String?
  testMode       String   @default("time") // time, words, quote, custom, zen
  duration       Int      // seconds
  language       String   @default("en")
  wpm            Float
  rawWpm         Float
  accuracy       Float
  errorCount     Int
  correctChars   Int
  incorrectChars Int
  consistency    Float
  mistakeDetails String?  // JSON string of mistyped keys mapping
  timelineData   String?  // JSON string of [{second, wpm, rawWpm, errors}]
  isFlagged      Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([wpm])
  @@index([createdAt])
}

model TypingLesson {
  id           String           @id @default(cuid())
  lessonNumber Int              @unique
  title        String
  description  String
  level        String           @default("beginner") // beginner, intermediate, advanced
  targetKeys   String           // Comma separated keys
  instructions String
  practiceText String
  minWpm       Int              @default(20)
  minAccuracy  Int              @default(90)
  order        Int              @default(1)
  createdAt    DateTime         @default(now())

  progress     LessonProgress[]
}

model LessonProgress {
  id           String       @id @default(cuid())
  userId       String
  lessonId     String
  completed    Boolean      @default(false)
  bestWpm      Float        @default(0)
  bestAccuracy Float        @default(0)
  attempts     Int          @default(0)
  completedAt  DateTime?
  updatedAt    DateTime     @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson TypingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model PracticeText {
  id         String   @id @default(cuid())
  title      String
  category   String   // words, sentences, programming, uzbek, russian, quotes
  language   String   @default("en")
  text       String
  difficulty String   @default("medium") // easy, medium, hard
  tags       String?
  createdAt  DateTime @default(now())
}

model Achievement {
  id            String            @id @default(cuid())
  code          String            @unique
  title         String
  description   String
  icon          String
  category      String            @default("speed") // speed, accuracy, consistency, endurance, streak
  xpReward      Int               @default(50)
  conditionType String            // wpm_threshold, accuracy_threshold, test_count, streak_days
  threshold     Float
  createdAt     DateTime          @default(now())

  users         UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model DailyChallenge {
  id             String          @id @default(cuid())
  date           String          @unique // YYYY-MM-DD
  title          String
  description    String
  targetMode     String          @default("time")
  targetWpm      Int             @default(60)
  targetAccuracy Int             @default(95)
  targetDuration Int             @default(60)
  xpReward       Int             @default(100)
  createdAt      DateTime        @default(now())

  userChallenges UserChallenge[]
}

model UserChallenge {
  id           String         @id @default(cuid())
  userId       String
  challengeId  String
  completed    Boolean        @default(false)
  bestWpm      Float          @default(0)
  bestAccuracy Float          @default(0)
  completedAt  DateTime?

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model UserStatistics {
  id              String   @id @default(cuid())
  userId          String   @unique
  totalTests      Int      @default(0)
  totalTimeSeconds Int     @default(0)
  avgWpm          Float    @default(0)
  bestWpm         Float    @default(0)
  avgAccuracy     Float    @default(0)
  totalCharacters Int      @default(0)
  totalErrors     Int      @default(0)
  currentStreak   Int      @default(0)
  bestStreak      Int      @default(0)
  lastActiveDate  String?  // YYYY-MM-DD
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameSession {
  id             String   @id @default(cuid())
  userId         String?
  isGuest        Boolean  @default(false)
  guestName      String?
  gameType       String   // word_rush, space_typist
  score          Int      @default(0)
  levelReached   Int      @default(1)
  wordsCompleted Int      @default(0)
  accuracy       Float    @default(100)
  maxCombo       Int      @default(0)
  duration       Int      @default(0) // seconds
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameType, score])
}

model LeaderboardEntry {
  id        String   @id @default(cuid())
  userId    String?
  username  String
  avatar    String?
  period    String   @default("all_time") // daily, weekly, monthly, all_time
  testMode  String   @default("time-60")
  wpm       Float
  rawWpm    Float
  accuracy  Float
  country   String?  @default("UZ")
  isFlagged Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([period, wpm])
}
